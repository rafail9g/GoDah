-- 1. Fungsi trigger: otomatis insert ke users/porters saat register
CREATE OR REPLACE FUNCTION public.handle_new_auth_user()
RETURNS TRIGGER
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE
  v_role TEXT;
  v_nama TEXT;
  v_no_hp TEXT;
BEGIN
  -- Ambil metadata yang dikirim saat signUp()
  v_role  := NEW.raw_user_meta_data->>'role';
  v_nama  := NEW.raw_user_meta_data->>'nama';
  v_no_hp := NEW.raw_user_meta_data->>'no_hp';

  IF v_role = 'porter' THEN
    INSERT INTO public.porters (id, nama, email, no_hp)
    VALUES (NEW.id, v_nama, NEW.email, v_no_hp)
    ON CONFLICT (id) DO NOTHING;
  ELSE
    -- Default: mahasiswa/user
    INSERT INTO public.users (id, nama, email, no_hp, password_hash)
    VALUES (NEW.id, v_nama, NEW.email, v_no_hp, 'supabase_managed')
    ON CONFLICT (id) DO NOTHING;
  END IF;

  RETURN NEW;
END;
$$;

-- 2. Pasang trigger ke auth.users
DROP TRIGGER IF EXISTS on_auth_user_created ON auth.users;
CREATE TRIGGER on_auth_user_created
  AFTER INSERT ON auth.users
  FOR EACH ROW
  EXECUTE FUNCTION public.handle_new_auth_user();


