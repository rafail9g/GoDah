-- ============================================================
--  GO-DAH DATABASE — Supabase Migration Script
--  Jalankan di: Supabase Dashboard > SQL Editor > New Query
--  Urutan eksekusi sudah diatur (FK dependencies terpenuhi)
-- ============================================================

-- Enable UUID extension (sudah aktif di Supabase by default, tapi aman dijalankan ulang)
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";


-- ============================================================
-- 1. ENUM TYPES
-- ============================================================

CREATE TYPE user_status AS ENUM ('aktif', 'nonaktif', 'diblokir');
CREATE TYPE porter_verif_status AS ENUM ('menunggu', 'disetujui', 'ditolak');
CREATE TYPE admin_role AS ENUM ('superadmin', 'admin');
CREATE TYPE jenis_layanan AS ENUM ('instant', 'terjadwal', 'semua');
CREATE TYPE order_status AS ENUM (
  'menunggu',
  'diterima',
  'menuju_lokasi',
  'dalam_perjalanan',
  'sampai_tujuan',
  'selesai',
  'batal'
);
CREATE TYPE notif_tipe AS ENUM ('pesanan_baru', 'status_update', 'pembayaran', 'sistem');


-- ============================================================
-- 2. TABEL: users
-- ============================================================

CREATE TABLE users (
  id            UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  nama          VARCHAR(100)  NOT NULL,
  email         VARCHAR(150)  NOT NULL UNIQUE,
  password_hash VARCHAR(255)  NOT NULL,
  no_hp         VARCHAR(15)   NOT NULL UNIQUE,
  alamat        TEXT,
  status        user_status   NOT NULL DEFAULT 'aktif',
  created_at    TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at    TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

COMMENT ON TABLE  users              IS 'Data mahasiswa pengguna layanan Go-Dah';
COMMENT ON COLUMN users.status       IS 'aktif | nonaktif | diblokir';


-- ============================================================
-- 3. TABEL: porters
-- ============================================================

CREATE TABLE porters (
  id                 UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  nama               VARCHAR(100)         NOT NULL,
  email              VARCHAR(150)         NOT NULL UNIQUE,
  no_hp              VARCHAR(15)          NOT NULL UNIQUE,
  foto_profil        VARCHAR(500),
  status_verifikasi  porter_verif_status  NOT NULL DEFAULT 'menunggu',
  is_aktif           BOOLEAN              NOT NULL DEFAULT FALSE,
  latitude           DECIMAL(10, 8),
  longitude          DECIMAL(11, 8),
  total_selesai      INT                  NOT NULL DEFAULT 0,
  created_at         TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at         TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

COMMENT ON TABLE  porters                   IS 'Data porter/kurir beserta lokasi real-time';
COMMENT ON COLUMN porters.is_aktif          IS 'TRUE = porter sedang online dan siap menerima order';
COMMENT ON COLUMN porters.latitude          IS 'Koordinat GPS terkini, diupdate saat porter aktif';


-- ============================================================
-- 4. TABEL: admins
-- ============================================================

CREATE TABLE admins (
  id            UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  nama          VARCHAR(100) NOT NULL,
  email         VARCHAR(150) NOT NULL UNIQUE,
  password_hash VARCHAR(255) NOT NULL,
  role          admin_role   NOT NULL DEFAULT 'admin',
  created_at    TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

COMMENT ON TABLE admins IS 'Data admin pengelola sistem Go-Dah';


-- ============================================================
-- 5. TABEL: kategori_barang (lookup/referensi)
-- ============================================================

CREATE TABLE kategori_barang (
  id         UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  nama       VARCHAR(100) NOT NULL UNIQUE,
  deskripsi  TEXT,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

COMMENT ON TABLE kategori_barang IS 'Referensi jenis/kategori barang yang bisa diangkut';

