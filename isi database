-- ============================================================
-- 6. TABEL: tarif
-- ============================================================

CREATE TABLE tarif (
  id              UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  admin_id        UUID           REFERENCES admins(id) ON DELETE SET NULL,
  nama_tarif      VARCHAR(100)   NOT NULL,
  jenis_layanan   jenis_layanan  NOT NULL DEFAULT 'semua',
  jenis_barang    VARCHAR(100),                         -- nullable = berlaku untuk semua jenis
  harga_dasar     DECIMAL(12, 2) NOT NULL DEFAULT 0,
  harga_per_km    DECIMAL(8,  2) NOT NULL DEFAULT 0,
  harga_per_kg    DECIMAL(8,  2) NOT NULL DEFAULT 0,
  berat_min       DECIMAL(6,  2) NOT NULL DEFAULT 0,    -- kg
  berat_max       DECIMAL(6,  2),                       -- nullable = tidak ada batas atas
  is_aktif        BOOLEAN        NOT NULL DEFAULT TRUE,
  created_at      TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at      TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

COMMENT ON TABLE  tarif              IS 'Aturan harga layanan, dikelola admin';
COMMENT ON COLUMN tarif.harga_dasar IS 'Biaya minimum sebelum ditambah komponen jarak/berat';
COMMENT ON COLUMN tarif.jenis_barang IS 'NULL = berlaku untuk semua kategori barang';

-- Formula: total = harga_dasar + (jarak_km * harga_per_km) + (berat_kg * harga_per_kg)

