-- ============================================================
-- 7. TABEL: orders
-- ============================================================

CREATE TABLE orders (
  id               UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  user_id          UUID           NOT NULL REFERENCES users(id)   ON DELETE RESTRICT,
  porter_id        UUID                    REFERENCES porters(id) ON DELETE SET NULL,
  tarif_id         UUID                    REFERENCES tarif(id)   ON DELETE SET NULL,
  lokasi_jemput    TEXT           NOT NULL,
  lokasi_tujuan    TEXT           NOT NULL,
  lat_jemput       DECIMAL(10, 8) NOT NULL,
  lng_jemput       DECIMAL(11, 8) NOT NULL,
  lat_tujuan       DECIMAL(10, 8) NOT NULL,
  lng_tujuan       DECIMAL(11, 8) NOT NULL,
  jenis_barang     VARCHAR(100),
  estimasi_berat   DECIMAL(6, 2),            -- kg
  jenis_layanan    jenis_layanan  NOT NULL DEFAULT 'instant',
  status           order_status   NOT NULL DEFAULT 'menunggu',
  total_biaya      DECIMAL(12, 2) NOT NULL DEFAULT 0,
  waktu_pesan      TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  waktu_selesai    TIMESTAMP WITH TIME ZONE,
  catatan          TEXT,
  created_at       TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at       TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

COMMENT ON TABLE  orders           IS 'Tabel inti pesanan jasa angkut barang';
COMMENT ON COLUMN orders.porter_id IS 'NULL saat status=menunggu, diisi setelah porter menerima order';
COMMENT ON COLUMN orders.status    IS 'Siklus: menunggu > diterima > menuju_lokasi > dalam_perjalanan > sampai_tujuan > selesai | batal';


-- ============================================================
-- 8. TABEL: order_tracking
-- ============================================================

CREATE TABLE order_tracking (
  id                UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  order_id          UUID           NOT NULL REFERENCES orders(id) ON DELETE CASCADE,
  status_perjalanan order_status   NOT NULL,
  latitude          DECIMAL(10, 8),
  longitude         DECIMAL(11, 8),
  catatan           TEXT,
  waktu_update      TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

COMMENT ON TABLE order_tracking IS 'Log real-time perubahan status dan lokasi porter per pesanan (append-only)';


-- ============================================================
-- 9. TABEL: bukti_pengiriman
-- ============================================================

CREATE TABLE bukti_pengiriman (
  id          UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  order_id    UUID         NOT NULL UNIQUE REFERENCES orders(id)  ON DELETE CASCADE,
  porter_id   UUID         NOT NULL        REFERENCES porters(id) ON DELETE RESTRICT,
  foto_url    VARCHAR(500) NOT NULL,
  keterangan  TEXT,
  created_at  TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

COMMENT ON TABLE  bukti_pengiriman          IS 'Foto bukti barang sudah sampai tujuan, diunggah porter';
COMMENT ON COLUMN bukti_pengiriman.order_id IS 'UNIQUE: satu order hanya boleh punya satu bukti pengiriman';


-- ============================================================
-- 10. TABEL: porter_verifikasi
-- ============================================================

CREATE TABLE porter_verifikasi (
  id                  UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  porter_id           UUID                  NOT NULL REFERENCES porters(id) ON DELETE CASCADE,
  admin_id            UUID                           REFERENCES admins(id)  ON DELETE SET NULL,
  status              porter_verif_status   NOT NULL DEFAULT 'menunggu',
  catatan_admin       TEXT,
  dokumen_url         VARCHAR(500),
  tanggal_verifikasi  TIMESTAMP WITH TIME ZONE,
  created_at          TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

COMMENT ON TABLE  porter_verifikasi          IS 'Rekam jejak proses verifikasi akun porter oleh admin';
COMMENT ON COLUMN porter_verifikasi.admin_id IS 'NULL sampai admin memproses pengajuan';


-- ============================================================
-- 11. TABEL: ratings
-- ============================================================

CREATE TABLE ratings (
  id          UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  order_id    UUID     NOT NULL UNIQUE REFERENCES orders(id)  ON DELETE CASCADE,
  user_id     UUID     NOT NULL        REFERENCES users(id)   ON DELETE RESTRICT,
  porter_id   UUID     NOT NULL        REFERENCES porters(id) ON DELETE RESTRICT,
  nilai       SMALLINT NOT NULL CHECK (nilai BETWEEN 1 AND 5),
  ulasan      TEXT,
  created_at  TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

COMMENT ON TABLE  ratings          IS 'Penilaian bintang dan ulasan user untuk porter setelah order selesai';
COMMENT ON COLUMN ratings.order_id IS 'UNIQUE: satu order hanya boleh punya satu rating';
COMMENT ON COLUMN ratings.nilai    IS 'Skala 1-5 bintang';


-- ============================================================
-- 12. TABEL: notifikasi
-- ============================================================

CREATE TABLE notifikasi (
  id          UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  user_id     UUID         REFERENCES users(id)   ON DELETE CASCADE,
  porter_id   UUID         REFERENCES porters(id) ON DELETE CASCADE,
  judul       VARCHAR(200) NOT NULL,
  pesan       TEXT         NOT NULL,
  tipe        notif_tipe   NOT NULL DEFAULT 'sistem',
  is_read     BOOLEAN      NOT NULL DEFAULT FALSE,
  created_at  TIMESTAMP WITH TIME ZONE DEFAULT NOW(),

  CONSTRAINT notif_target_check CHECK (
    (user_id IS NOT NULL AND porter_id IS NULL) OR
    (user_id IS NULL AND porter_id IS NOT NULL)
  )
);

COMMENT ON TABLE  notifikasi IS 'Notifikasi sistem ke user atau porter (salah satu harus diisi, tidak keduanya)';


-- ============================================================
-- 13. INDEKS — untuk performa query umum
-- ============================================================

-- orders: filter by user, porter, dan status (paling sering diquery)
CREATE INDEX idx_orders_user_id    ON orders(user_id);
CREATE INDEX idx_orders_porter_id  ON orders(porter_id);
CREATE INDEX idx_orders_status     ON orders(status);
CREATE INDEX idx_orders_waktu      ON orders(waktu_pesan DESC);

-- order_tracking: ambil log tracking per order
CREATE INDEX idx_tracking_order_id ON order_tracking(order_id);
CREATE INDEX idx_tracking_waktu    ON order_tracking(waktu_update DESC);

-- notifikasi: notif yang belum dibaca
CREATE INDEX idx_notif_user_unread   ON notifikasi(user_id, is_read)   WHERE is_read = FALSE;
CREATE INDEX idx_notif_porter_unread ON notifikasi(porter_id, is_read) WHERE is_read = FALSE;

-- porter: cari porter aktif dan terverifikasi
CREATE INDEX idx_porters_aktif ON porters(is_aktif, status_verifikasi);

-- ratings: hitung rata-rata rating porter
CREATE INDEX idx_ratings_porter_id ON ratings(porter_id);


-- ============================================================
-- 14. TRIGGER: auto-update kolom updated_at
-- ============================================================

CREATE OR REPLACE FUNCTION trigger_set_updated_at()
RETURNS TRIGGER AS $$
BEGIN
  NEW.updated_at = NOW();
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER set_updated_at_users
  BEFORE UPDATE ON users
  FOR EACH ROW EXECUTE FUNCTION trigger_set_updated_at();

CREATE TRIGGER set_updated_at_porters
  BEFORE UPDATE ON porters
  FOR EACH ROW EXECUTE FUNCTION trigger_set_updated_at();

CREATE TRIGGER set_updated_at_orders
  BEFORE UPDATE ON orders
  FOR EACH ROW EXECUTE FUNCTION trigger_set_updated_at();

CREATE TRIGGER set_updated_at_tarif
  BEFORE UPDATE ON tarif
  FOR EACH ROW EXECUTE FUNCTION trigger_set_updated_at();


