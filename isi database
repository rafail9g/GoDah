-- 15. ROW LEVEL SECURITY (RLS) — Supabase Auth Integration
--     Aktifkan RLS agar data aman via Supabase client
-- ============================================================

ALTER TABLE users             ENABLE ROW LEVEL SECURITY;
ALTER TABLE porters           ENABLE ROW LEVEL SECURITY;
ALTER TABLE orders            ENABLE ROW LEVEL SECURITY;
ALTER TABLE order_tracking    ENABLE ROW LEVEL SECURITY;
ALTER TABLE bukti_pengiriman  ENABLE ROW LEVEL SECURITY;
ALTER TABLE ratings           ENABLE ROW LEVEL SECURITY;
ALTER TABLE notifikasi        ENABLE ROW LEVEL SECURITY;

-- Contoh policy: user hanya bisa lihat data miliknya sendiri
-- (Sesuaikan dengan sistem auth yang kamu pakai)

CREATE POLICY "User lihat order sendiri"
  ON orders FOR SELECT
  USING (auth.uid() = user_id);

CREATE POLICY "User buat order sendiri"
  ON orders FOR INSERT
  WITH CHECK (auth.uid() = user_id);

CREATE POLICY "User lihat notif sendiri"
  ON notifikasi FOR SELECT
  USING (auth.uid() = user_id);

